# FortiConnect Backend — Environment Variables
# Copy this file to .env and fill in values for your local setup.
# NEVER commit .env with real values.

# Django
SECRET_KEY=your-secret-key-here-change-this-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
LOG_LEVEL=INFO

# Database (PostgreSQL)
DATABASE_URL=postgres://forticonnect_user:your_password@localhost:5432/forticonnect_dev

# Redis (required for WebSockets and presence)
REDIS_URL=redis://localhost:6379/0

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# JWT
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Application limits
MAX_MESSAGE_LENGTH=4000

